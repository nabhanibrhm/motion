{
  "name": "motion",
  "version": "0.1.0",
  "private": true,
  "description": "Motion animation videos built with Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render:explainer": "remotion render Explainer out/explainer.mp4",
    "render:short": "remotion render Short out/short.mp4",
    "still": "remotion still Explainer out/explainer.png --frame=60",
    "render:f1": "node scripts/render.mjs F1Explosion out/f1-explosion.mp4",
    "voice": "python voiceover/generate.py voiceover/f1.json",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade",
    "sync": "node scripts/sync.mjs",
    "preview": "node scripts/hf.mjs preview",
    "check": "node scripts/hf.mjs check",
    "lint": "node scripts/hf.mjs lint",
    "stills": "node scripts/stills.mjs",
    "render:v3": "node scripts/hf.mjs render -o out/f1-explosion-v3.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "hyperframes": "0.8.210",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
