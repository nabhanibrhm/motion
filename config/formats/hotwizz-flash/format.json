{
  "description": "HotWizz Flash: five hw-* data scenes, hotwizz theme, narrator Nisa (wec, Cartesia).",
  "category": "Berita",
  "theme": "hotwizz",
  "case": {
    "prefix": "HOTWIZZ",
    "counter": {
      "theme": "hotwizz"
    }
  },
  "episode": {
    "schemaVersion": 1,
    "id": "{{id}}",
    "number": "{{number}}",
    "title": "{{title}}",
    "category": "{{category}}",
    "theme": "hotwizz",
    "narration": "narration.json",
    "script": "script-short.md",
    "video": {
      "width": 1080,
      "height": 1920,
      "fps": 30
    },
    "runtime": {
      "profile": "modern",
      "case": {
        "id": "{{caseId}}",
        "steps": "{{steps}}"
      }
    },
    "scenes": [
      {
        "id": "hook",
        "template": "hw-hook",
        "props": {
          "headline": "TOKOH\n*KLAIM UTAMA*",
          "claim": "GANTI DENGAN KLAIM HOOK",
          "tag": "KATA SUMBER",
          "person": {
            "name": "NAMA TOKOH",
            "role": "Jabatan",
            "photo": null
          }
        }
      },
      {
        "id": "resmi",
        "template": "hw-resmi",
        "props": {
          "items": [
            {
              "text": "Fakta resmi pertama",
              "source": "Media A, Media B"
            },
            {
              "text": "Fakta resmi kedua",
              "source": "Media A, Media C"
            },
            {
              "text": "Fakta resmi ketiga",
              "source": "Media B, Media C"
            }
          ]
        }
      },
      {
        "id": "belum",
        "template": "hw-split",
        "props": {
          "left": {
            "items": [
              {
                "text": "Yang sudah dikonfirmasi"
              },
              {
                "text": "Pernyataan resmi"
              }
            ]
          },
          "right": {
            "items": [
              {
                "text": "Yang belum dijelaskan"
              },
              {
                "text": "Pertanyaan terbuka"
              }
            ]
          }
        }
      },
      {
        "id": "kutipan",
        "template": "hw-quote",
        "props": {
          "person": {
            "name": "NAMA TOKOH",
            "role": "Jabatan",
            "photo": null
          },
          "quote": "Kutipan persis dari sumber.",
          "source": "Media A"
        }
      },
      {
        "id": "penutup",
        "template": "hw-cover",
        "props": {
          "lines": [
            {
              "text": "INGAT",
              "style": "kicker"
            },
            {
              "text": "*PRADUGA* TAK BERSALAH"
            },
            {
              "text": "FOLLOW UNTUK UPDATE",
              "style": "cta"
            }
          ],
          "cover": {
            "title": "JUDUL\n*COVER*",
            "chip": "KLAIM SINGKAT?"
          }
        }
      }
    ],
    "audio": {
      "bed": null,
      "bedGain": 0.3,
      "loudness": {
        "integrated": -14,
        "truePeak": -1,
        "range": 11
      }
    }
  },
  "narration": {
    "source": "cartesia",
    "speakers": {
      "wec": {
        "supertonic": {
          "voice": "F2",
          "speed": 1,
          "range": 1.4
        }
      }
    },
    "chapters": [
      {
        "id": "update",
        "title": "{{title}}"
      }
    ],
    "defaults": {
      "lead": 0.15,
      "tail": 0.1,
      "gapSameSpeaker": 0.1,
      "gapNewSpeaker": 0.1,
      "firstLead": 0.2,
      "chapterLead": 0.1,
      "chapterEndTail": 0.1
    },
    "sections": [
      {
        "id": "hook",
        "chapter": "update",
        "lines": [
          {
            "speaker": "wec",
            "text": "Ganti: nama tokoh terkenal dan klaim utama dalam satu kalimat, tanpa koma berlebihan."
          }
        ]
      },
      {
        "id": "resmi",
        "chapter": "update",
        "lines": [
          {
            "speaker": "wec",
            "text": "Ganti: fakta resmi pertama, kedua dan ketiga, masing-masing dari dua media."
          }
        ]
      },
      {
        "id": "belum",
        "chapter": "update",
        "lines": [
          {
            "speaker": "wec",
            "text": "Ganti: yang resmi dan yang belum jelas, dengan bobot yang sama."
          }
        ]
      },
      {
        "id": "kutipan",
        "chapter": "update",
        "lines": [
          {
            "speaker": "wec",
            "text": "Ganti: kutipan tokoh dengan sumber dan tanggal, atau hapus adegan ini."
          }
        ]
      },
      {
        "id": "penutup",
        "chapter": "update",
        "lines": [
          {
            "speaker": "wec",
            "text": "Ganti: status hukum, praduga tak bersalah, lalu ajakan follow untuk update.",
            "after": 1.2
          }
        ]
      }
    ]
  }
}
